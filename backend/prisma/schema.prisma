generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────


enum TypeMouvement {
  ENTREE
  SORTIE
}

enum StatutCommande {
  EN_ATTENTE           // Reçue, pas encore traitée par Log1
  EN_VALIDATION        // Log1 en cours de validation
  VALIDEE              // Validée par Log1
  EN_ATTENTE_LOG2      // Transmise à Log2, en attente d'expédition
  EXPEDIEE             // Expédiée par Log2
  LIVREE               // Confirmée reçue par le prestataire
  ANNULEE
  REFUSEE              // Refusée par Log1 avec motif
}

enum StatutLivraison {
  EN_ATTENTE
  EN_COURS
  LIVREE
  INCIDENT
}

enum ProdSav {
  PROD
  SAV
  MALFACON
  AUTRE
}

// ─── UTILISATEURS ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  nom            String
  prenom         String
  role           String   @default("LOGISTICIEN_2")
  actif          Boolean  @default(true)
  privileges     Json?    // UserPrivileges JSON object
  managerZoneId  String?  // liaison optionnelle à un ManagerZone
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commandesValidees  Commande[] @relation("ValideurLog1")
  commandesExpediees Commande[] @relation("ExpediteurLog2")
  mouvements         Mouvement[]
  commandesTS        CommandeTS[]
  managerZone        ManagerZone? @relation(fields: [managerZoneId], references: [id], onDelete: SetNull)

  @@map("users")
}

// ─── ENTREPÔTS ────────────────────────────────────────────────────────────────

model Entrepot {
  id           String   @id @default(uuid())
  code         String   @unique
  nom          String
  localisation String
  gestionnaire String?
  adresse      String?
  telephone    String?
  email        String?
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stocks                 Stock[]
  mouvements             Mouvement[]
  livraisons             Livraison[]
  repartitionsCommandeTS RepartitionCommandeTS[]

  @@map("entrepots")
}

// ─── ARTICLES ─────────────────────────────────────────────────────────────────

model Article {
  id                  String   @id @default(uuid())
  reference           String   @unique
  nom                 String
  description         String?
  unite               String   @default("unité")
  seuilAlerte         Int      @default(10)
  actif               Boolean  @default(true)
  regleConsommation   String?
  facteurConsommation Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stocks             Stock[]
  mouvements         Mouvement[]
  lignesCommande     LigneCommande[]
  lignesLivraison    LigneLivraison[]
  consommations      Consommation[]
  inventaires        InventairePhysique[]
  lignesCommandeTS   LigneCommandeTS[]

  @@map("articles")
}

// ─── STOCK ────────────────────────────────────────────────────────────────────

model Stock {
  id         String   @id @default(uuid())
  articleId  String
  entrepotId String
  quantite   Int      @default(0)
  updatedAt  DateTime @updatedAt

  article  Article  @relation(fields: [articleId], references: [id])
  entrepot Entrepot @relation(fields: [entrepotId], references: [id])

  @@unique([articleId, entrepotId])
  @@map("stocks")
}

// ─── MOUVEMENTS ───────────────────────────────────────────────────────────────

model Mouvement {
  id                 String        @id @default(uuid())
  date               DateTime      @default(now())
  articleId          String
  entrepotId         String
  type               TypeMouvement
  quantiteDemandee   Int
  quantiteValidee    Int?
  quantiteFournie    Int
  departement        String?
  numeroCommande     String?
  numeroOperation    String?
  sourceDestination  String?
  prodSav            ProdSav       @default(PROD)
  commentaire        String?
  adresseMail        String?
  manager            String?
  infoSupplementaire String?
  adresse            String?
  cout               Float?
  envoye             Boolean       @default(false)
  recu               Boolean       @default(false)
  userId             String?
  commandeId         String?
  livraisonId        String?       // livraison fournisseur qui a généré ce mouvement
  transfertId        String?       // UUID liant les 2 mouvements d'un transfert inter-entrepôt
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  deletedByName      String?

  article   Article    @relation(fields: [articleId], references: [id])
  entrepot  Entrepot   @relation(fields: [entrepotId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  commande  Commande?  @relation(fields: [commandeId], references: [id])
  livraison Livraison? @relation(fields: [livraisonId], references: [id], onDelete: SetNull)

  @@map("mouvements")
}

// ─── COMMANDES ────────────────────────────────────────────────────────────────

model Commande {
  id                   String         @id @default(uuid())
  numero               String         @unique
  dateReception        DateTime       @default(now())
  dateCommande         DateTime?      // date sur le bon de commande prestataire
  dateTraitement       DateTime?      // date de validation Log1
  dateTransmissionLog2 DateTime?      // date de transmission à Log2
  dateExpedition       DateTime?      // date expédition Log2
  dateLivraison        DateTime?      // date confirmation livraison
  departement          String
  demandeur            String?
  emailDemandeur       String?
  societe              String?        // société du prestataire
  interlocuteur        String?        // interlocuteur
  manager              String?
  nombreGrilles        Int?
  typeGrille           String?        // type de grille
  statut               StatutCommande @default(EN_ATTENTE)
  commentaire          String?
  commentaireLog2      String?
  commentaireRefus     String?   // motif de refus Log1
  fichierExcelUrl      String?
  fichierPerceptionUrl String?
  bonRetourUrl         String?
  emailEnvoye          Boolean        @default(false)
  dateEmailEnvoye      DateTime?
  bonRetourRecu        Boolean        @default(false)
  dateBonRetourRecu    DateTime?
  tokenPublic              String?        @unique
  telephoneDestinataire    String?
  adresseLivraison         String?
  deletedAt                DateTime?
  deletedById              String?
  deletedByName            String?
  valideurId               String?
  expediteurId             String?
  intervenantId            String?

  entrepotSource           String?        // entrepôt choisi par Log1 à la validation
  entrepotDestinationId    String?        // entrepôt destination (commandes de type TRANSFERT)
  typeCommande             String?        @default("STANDARD") // STANDARD | TRANSFERT

  lienId           String?
  typePrestataire  String?
  lien             LienPrestataire? @relation(fields: [lienId], references: [id])

  valideur     User?        @relation("ValideurLog1", fields: [valideurId], references: [id])
  expediteur   User?        @relation("ExpediteurLog2", fields: [expediteurId], references: [id])
  intervenant  Intervenant? @relation(fields: [intervenantId], references: [id], onDelete: SetNull)

  lignes     LigneCommande[]
  mouvements Mouvement[]
  livraisons Livraison[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commandes")
}

model LigneCommande {
  id               String  @id @default(uuid())
  commandeId       String
  articleId        String
  quantiteDemandee Int
  quantiteValidee  Int?
  quantiteFournie  Int?
  commentaire      String?
  stockDisponible  Int?
  entrepotSource   String?

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  article  Article  @relation(fields: [articleId], references: [id])

  @@map("lignes_commande")
}

// ─── MANAGER DE ZONE ──────────────────────────────────────────────────────────

model ManagerZone {
  id           String              @id @default(uuid())
  nom          String
  departements Json                @default("[]")
  actif        Boolean             @default(true)
  createdAt    DateTime            @default(now())
  liens        LienPrestataire[]
  users        User[]

  @@map("managers_zone")
}

// ─── LIEN PRESTATAIRE ─────────────────────────────────────────────────────────

model LienPrestataire {
  id                 String       @id @default(uuid())
  token              String       @unique @default(uuid())
  nom                String
  actif              Boolean      @default(true)
  expiresAt          DateTime?
  createdBy          String?
  utilisations       Int          @default(0)
  createdAt          DateTime     @default(now())

  managerZoneId      String?
  typePrestataire    String?
  departementsActifs String[]     @default([])

  managerZone        ManagerZone? @relation(fields: [managerZoneId], references: [id])
  commandes          Commande[]

  @@map("liens_prestataire")
}

// ─── LIVRAISONS FOURNISSEURS ──────────────────────────────────────────────────

model Livraison {
  id              String          @id @default(uuid())
  numero          String          @unique
  dateLivraison   DateTime        @default(now())
  fournisseur     String
  entrepotId      String
  statut          StatutLivraison @default(EN_ATTENTE)
  bonLivraisonUrl String?
  bonCommandeUrl  String?
  commentaire     String?
  commandeId      String?
  deletedAt       DateTime?
  deletedById     String?
  deletedByName   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  entrepot   Entrepot         @relation(fields: [entrepotId], references: [id])
  commande   Commande?        @relation(fields: [commandeId], references: [id])
  lignes     LigneLivraison[]
  mouvements Mouvement[]

  @@map("livraisons")
}

model LigneLivraison {
  id                String  @id @default(uuid())
  livraisonId       String
  articleId         String
  quantiteCommandee Int
  quantiteRecue     Int
  commentaire       String?

  livraison Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  article   Article   @relation(fields: [articleId], references: [id])

  @@map("lignes_livraison")
}

// ─── CONSOMMATION ─────────────────────────────────────────────────────────────

model Consommation {
  id                  String   @id @default(uuid())
  date                DateTime
  articleId           String
  departement         String?
  quantiteTheorique   Float
  quantiteReelle      Float
  ecart               Float
  nombreInterventions Int      @default(0)
  source              String?
  createdAt           DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id])

  @@map("consommations")
}

// ─── INVENTAIRE PHYSIQUE ──────────────────────────────────────────────────────

model InventairePhysique {
  id            String    @id @default(uuid())
  articleId     String
  entrepotId    String
  quantite      Int
  date          DateTime  @default(now())
  userId        String?
  commentaire   String?
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?

  article      Article                @relation(fields: [articleId], references: [id])
  corrections  CorrectionInventaire[]

  @@map("inventaires_physiques")
}

model CorrectionInventaire {
  id              String   @id @default(uuid())
  inventaireId    String
  quantiteAvant   Int
  quantiteApres   Int
  commentaire     String
  correctedById   String?
  correctedByName String
  createdAt       DateTime @default(now())

  inventaire InventairePhysique @relation(fields: [inventaireId], references: [id], onDelete: Cascade)

  @@map("corrections_inventaire")
}

// ─── COMMANDES TS (APPROVISIONNEMENT PÉRIODIQUE) ──────────────────────────────

model CommandeTS {
  id          String   @id @default(uuid())
  numero      String   @unique
  titre       String
  dateDebut   DateTime
  dateFin     DateTime
  statut        String   @default("EN_COURS") // EN_COURS, CLOTUREE
  commentaire   String?
  createdById   String?
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User?           @relation(fields: [createdById], references: [id])
  lignes    LigneCommandeTS[]

  @@map("commandes_ts")
}

model LigneCommandeTS {
  id           String @id @default(uuid())
  commandeTSId String
  articleId    String
  qteProd      Int    @default(0)
  qteSav       Int    @default(0)
  qteMalfacon  Int    @default(0)

  commandeTS   CommandeTS              @relation(fields: [commandeTSId], references: [id], onDelete: Cascade)
  article      Article                 @relation(fields: [articleId], references: [id])
  repartitions RepartitionCommandeTS[]

  @@unique([commandeTSId, articleId])
  @@map("lignes_commandes_ts")
}

model RepartitionCommandeTS {
  id                String @id @default(uuid())
  ligneCommandeTSId String
  entrepotId        String
  tauxRepartition   Float  @default(0)
  qteRecue          Int    @default(0)

  ligneCommandeTS LigneCommandeTS @relation(fields: [ligneCommandeTSId], references: [id], onDelete: Cascade)
  entrepot        Entrepot        @relation(fields: [entrepotId], references: [id])

  @@unique([ligneCommandeTSId, entrepotId])
  @@map("repartitions_commandes_ts")
}

// ─── RÉPERTOIRE SOCIÉTÉS / INTERVENANTS ──────────────────────────────────────

model Societe {
  id          String   @id @default(uuid())
  nom         String
  code        String?  @unique
  adresse     String?
  telephone   String?
  email       String?
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  intervenants Intervenant[]

  @@map("societes")
}

model Intervenant {
  id              String   @id @default(uuid())
  nom             String
  prenom          String
  email           String?
  telephone       String?
  societeId       String?
  actif           Boolean  @default(true)
  autoEntrepreneur Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  societe   Societe?   @relation(fields: [societeId], references: [id])
  commandes Commande[]

  @@map("intervenants")
}

// ─── MODULE CONSOMMABLES TERRAIN ─────────────────────────────────────────────
//
// Pipeline : Upload Excel → ETL Python → InterventionTerrain (PostgreSQL)
//            → requêtes groupées → affichage dashboard
//
// Chaque import charge un fichier Excel (INTERVENTION TECHNO SMART, ~400k lignes).
// ImportConsommableLog trace chaque opération.
// FormuleConsommable stocke les coefficients éditables (les conditions de calcul
// sont implémentées dans le service, les paramètres sont ici).

model ImportConsommableLog {
  id                String   @id @default(uuid())
  nomFichier        String
  dateImport        DateTime @default(now())
  nbLignesTotal     Int      @default(0)
  nbLignesImportees Int      @default(0)
  nbErreurs         Int      @default(0)
  dureeSecondes     Float?
  statut            String   // SUCCES | ECHEC | PARTIEL
  erreurs           Json?    // [{ligne: 42, message: "..."}]
  periodeDebut      DateTime?
  periodeFin        DateTime?
  createdAt         DateTime @default(now())

  interventions InterventionTerrain[]

  @@map("imports_consommable_log")
}

model InterventionTerrain {
  id                  String   @id @default(uuid())

  // ── Identifiants source ──────────────────────────────────────────────────
  idInterventionIw    BigInt?
  idInterventionGrdv  BigInt?

  // ── Technicien & société ─────────────────────────────────────────────────
  idTechnicienCas     BigInt?
  nomTechnicien       String?  // Paramètre.Tech — ex: "GOS François"
  nomSociete          String?  // Paramètre.Nom de la sociètèe — ex: "HZ groupe"

  // ── Géographie ───────────────────────────────────────────────────────────
  codeDepartement     String?  // Code département NRO — ex: "49"
  departement         String?  // Département NRO — ex: "Maine-et-Loire"

  // ── Temporel ─────────────────────────────────────────────────────────────
  dateIntervention    DateTime?
  moisIntervention    DateTime? // tronqué au 1er du mois pour groupements
  semaineIntervention String?   // ex: "2025-W49"

  // ── Technique ────────────────────────────────────────────────────────────
  technologie         String?  // PON | P2P
  infrastructure      String?  // Standard | Poteau | Chambre | Façade
  operateur           String?  // ORANGE | FREE | SFR
  typeAbonne          String?  // New | Migration
  modeleModem         String?  // Freebox Révolution | Freebox Pop | etc.

  // ── Classification (colonnes calculées dans l'Excel) ─────────────────────
  typezone            String?  // ZMD | ZTD | RIP
  activites           String?  // PROD | SAV  (calculé depuis le champ Activité)
  typePresta          String?  // PLP | Autre (calculé depuis AboRacco–debriefPLP)

  // ── Résultat intervention ─────────────────────────────────────────────────
  etat                String?  // OK | NOK
  codeCloture         String?
  categorieEchec      String?

  // ── Champs pour formules spécifiques ─────────────────────────────────────
  // Nécessaires pour Déport de PTO (E22/E23) et EPIBOX (E28) — actuellement
  // cassés dans l'Excel (#REF!), à reconstruire depuis les vraies colonnes.
  aboRacco110         String?  // AboRacco – 110 (type débrief PTO)
  aboRacco120         String?  // AboRacco – 120

  // ── Traçabilité import ────────────────────────────────────────────────────
  sourceImportId      String?
  createdAt           DateTime @default(now())

  sourceImport ImportConsommableLog? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  // Index pour les requêtes de calcul (COUNTIFS-équivalents en SQL)
  @@index([typezone, activites, etat])
  @@index([typezone, activites, etat, infrastructure])
  @@index([technologie, activites, typeAbonne, etat])
  @@index([codeDepartement])
  @@index([moisIntervention])
  @@index([semaineIntervention])
  @@index([nomTechnicien])
  @@index([nomSociete])
  @@index([sourceImportId])
  @@map("interventions_terrain")
}

model FormuleConsommable {
  id                   String   @id @default(uuid())
  ordre                Int      @default(0)        // ordre d'affichage
  actif                Boolean  @default(true)

  // ── Identification produit ────────────────────────────────────────────────
  codeArticle          String   @unique             // ex: "O-KPTOMA40-0-PN"
  nomProduit           String                       // ex: "KIT PTO MONO 40M"
  categorie            String?                      // ex: "STANDARD - ZMD MONO"

  // ── Description lisible de la formule ────────────────────────────────────
  // Affichée dans l'UI pour expliquer le calcul à l'utilisateur.
  // Ex: "40% des interventions PROD OK ZMD Standard hors PLP"
  descriptionFormule   String

  // ── Conditions de filtre (null = pas de filtre sur cette dimension) ───────
  conditionZone        String?  // ZMD | ZTD | RIP | null
  conditionInfra       String?  // Standard | Poteau | Chambre | null
  conditionInfraMode   String   @default("EQ")  // EQ (=) ou NEQ (<>)
  conditionEtat        String?  // OK | NOK | null (= OK+NOK)
  conditionActivite    String   @default("PROD") // PROD | SAV | tous
  conditionTechnologie String?  // PON | P2P | null
  conditionTypeAbonne  String?  // New | Migration | null
  excludePLP           Boolean  @default(false)  // exclure typePresta = "PLP"

  // ── Coefficients éditables ────────────────────────────────────────────────
  // Ce sont les seuls paramètres modifiables par l'utilisateur.
  // La logique de filtre est dans le service, le coefficient est ici.
  multiplicateur       Float    @default(1.0)
  multiplicateurNok    Float    @default(0.0)  // ratio sur les NOK (ex: 0.15)
  minimumQte           Int?     // quantité minimum (null = pas de minimum fixe)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("formules_consommable")
}

// ─── RÉFÉRENTIEL TECHNICIENS ─────────────────────────────────────────────────
// Importé depuis le fichier de référence. Permet d'enrichir les interventions
// terrain dont les colonnes nomTechnicien / nomSociete sont vides.

model TechnicienRef {
  id            String   @id @default(uuid())
  idCas         BigInt   @unique
  nomTechnicien String
  nomSociete    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("techniciens_ref")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  titre     String
  message   String
  lue       Boolean  @default(false)
  lien      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}
