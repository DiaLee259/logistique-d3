{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate && npm run build",
  "installCommand": "cd backend && npm install",
  "functions": {
    "backend/api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "backend/dist/**,backend/node_modules/.prisma/**,backend/node_modules/@prisma/client/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/backend/api/index.js" }]
}
